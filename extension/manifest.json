{
  "manifest_version": 3,
  "name": "IDM Integration Module Twin",
  "version": "1.2.0",
  "description": "Captures download links, video streams, HLS m3u8, and MPEG-DASH files and sends them directly to the IDM Downloader Engine.",
  "permissions": ["downloads", "webRequest", "storage", "cookies", "scripting", "nativeMessaging", "contextMenus", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IDM Integration Module",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
